# === Default: ignore everything at root (keep process/governance files local) ===
/*

# === Public deliverables (docs, schema, vectors, reference implementations, and verification tests) ===
!/docs/
!/schema/
!/schemas/
!/src/
!/reference-impls/
!/vectors/
!/tests/
!/package.json
!/pnpm-lock.yaml
!/tsconfig.json
!/vitest.config.ts
!/README.md
!/LICENSE
!/LICENSE-DOCS
!/SECURITY.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/docs-ci.yml

# === Exclude build/cache/OS noise inside allowed directories ===
.DS_Store
*.swp
*.swo
*~
Thumbs.db
node_modules/
dist/
coverage/
reference-impls/rust/target/
